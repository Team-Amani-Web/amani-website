---
import Base from "../layouts/Base.astro";
import StoryCard from "../components/StoryCard.astro";
import { getProgrammes, getStories } from "../lib/content";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const [programmes, stories] = await Promise.all([getProgrammes(), getStories()]);
  return programmes.map((p) => ({
    params: { programme: p.slug },
    props: { programme: p, stories },
  }));
}

const { programme, stories } = Astro.props;
const related = stories.filter((s) => s.category === programme.title).slice(0, 3);
---
<Base title={programme.title} description={programme.summary} image={programme.image} current={programme.slug}>
  <header class="page-head">
    <div class="container">
      <p class="page-head-eyebrow">{programme.eyebrow}</p>
      <h1 class="page-head-title">{programme.title}</h1>
      <p class="page-head-lede">{programme.summary}</p>
    </div>
  </header>

  <div class="article-hero" style={`background-image:url('${programme.image}')`}></div>

  <section class="page-section">
    <div class="container">
      <div class="article-wrap">
        {typeof programme.body === "string"
          ? <Fragment set:html={programme.body} />
          : <PortableText value={programme.body} />}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="page-section tint">
      <div class="container">
        <h2 class="squad-heading">Related stories</h2>
        <div class="grid-cards">{related.map((s) => <StoryCard story={s} />)}</div>
      </div>
    </section>
  )}
</Base>
